# ── LLM endpoint (OpenAI-compatible) ─────────────────────────────
# Tempel URL yang tercetak di notebook Colab (URL proxy Cloudflare).
# Ini berubah setiap kali memulai ulang Colab.
BASE_URL=https://your-colab-url.trycloudflare.com

# API Key yang diharapkan oleh proxy LiteLLM (sesuai dengan API_KEY dalam skrip Colab).
LLM_API_KEY=sk-colab-local

# Nama model yang diekspos oleh proxy Anda (sesuai dengan konfigurasi LiteLLM).
MODEL_NAME=character1

# ── Otentikasi aplikasi (opsional tetapi disarankan pada WiFi bersama) ───────────
# Biarkan kosong untuk menonaktifkan otentikasi. Atur rahasia apa pun untuk mewajibkannya.
APP_TOKEN=

# ── Server ───────────────────────────────────────────────────────
PORT=3000

# ── Generation tuning ────────────────────────────────────────────
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
MAX_TOKENS=1024

REPLY_LANGUAGE=Indonesian