# ── LLM endpoint (OpenAI-compatible) ─────────────────────────────
# Paste the URL your Colab notebook prints (the Cloudflare tunnel URL).
# It changes every time you restart Colab.
BASE_URL=https://your-colab-url.trycloudflare.com

# API key expected by the LiteLLM proxy (matches API_KEY in the Colab script).
LLM_API_KEY=sk-colab-local

# Model name your proxy exposes (matches the LiteLLM config).
MODEL_NAME=character1

# ── App auth (optional but recommended on shared WiFi) ───────────
# Leave empty to disable auth. Set any secret to require it.
APP_TOKEN=

# ── Server ───────────────────────────────────────────────────────
PORT=3000

# ── Generation tuning ────────────────────────────────────────────
TEMPERATURE=0.8
TOP_P=0.9
MAX_TOKENS=800

REPLY_LANGUAGE=Indonesian